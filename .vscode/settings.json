{
  "oxc.enable": true,
  "eslint.enable": true,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
    "source.sortImports": "never"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "eslint.validate": [
    "vue",
    "xml",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "js/ts.experimental.useTsgo": false,
  "cSpell.allowCompoundWords": true,
  "cSpell.words": [
    "bangumi",
    "bili",
    "bilibili",
    "bilivideo",
    "bumpp",
    "bvid",
    "changelogithub",
    "clsx",
    "cmdk",
    "ctts",
    "danmaku",
    "demuxer",
    "demuxers",
    "dtrace",
    "durl",
    "Emscripten",
    "esbuild",
    "ffprobe",
    "fnval",
    "fnver",
    "fourk",
    "hdslb",
    "HKCU",
    "iconify",
    "IDBP",
    "llseek",
    "lucide",
    "MDAT",
    "mfra",
    "mfro",
    "mmap",
    "moof",
    "moov",
    "muxer",
    "nocheck",
    "nums",
    "nuxt",
    "ofetch",
    "OPFS",
    "oxfmt",
    "oxfmtrc",
    "oxlint",
    "pinia",
    "pycache",
    "Referer",
    "reka",
    "Remux",
    "remuxed",
    "remuxer",
    "remuxes",
    "remuxing",
    "saio",
    "saiz",
    "senc",
    "shadcn",
    "stco",
    "stsc",
    "stss",
    "stsz",
    "stts",
    "tfdt",
    "TFHD",
    "tfra",
    "traf",
    "trun",
    "undownloadable",
    "uniquified",
    "uniquify",
    "unplugin",
    "unrs",
    "VITE",
    "vitepress",
    "vlist",
    "vueuse",
    "WORKERFS"
  ]
}
