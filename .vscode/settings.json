{
  "oxc.enable": true,
  "eslint.enable": true,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
    "source.sortImports": "never"
  },
  "eslint.validate": [
    "vue",
    "xml",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "js/ts.experimental.useTsgo": false,
  "cSpell.allowCompoundWords": true,
  "cSpell.words": [
    "bili",
    "bilibili",
    "bumpp",
    "bvid",
    "changelogithub",
    "clsx",
    "cmdk",
    "danmaku",
    "dtrace",
    "esbuild",
    "iconify",
    "IDBP",
    "lucide",
    "nocheck",
    "nums",
    "nuxt",
    "ofetch",
    "oxfmt",
    "oxfmtrc",
    "oxlint",
    "pinia",
    "reka",
    "shadcn",
    "unplugin",
    "unrs",
    "VITE",
    "vueuse"
  ]
}
