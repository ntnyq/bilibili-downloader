{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitepress/client"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [".vitepress/**/*.ts"]
}
