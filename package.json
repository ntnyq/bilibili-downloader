{
  "name": "bilibili-downloader",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Download Bilibili videos, audio, covers, subtitles and danmaku, with multi-part batch downloads and asset bundles.",
  "keywords": [
    "wxt"
  ],
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "compile": "vue-tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "release": "bumpp",
    "test": "tsx --test utils/bilibili/*.test.ts utils/downloads/*.test.ts",
    "test:native": "python3 -m unittest discover -s scripts -p '*_test.py'",
    "typecheck": "vue-tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@lucide/vue": "^1.55.0",
    "@ntnyq/utils": "^0.23.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "js-md5": "^0.9.2",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "webext-bridge": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.25",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-vue": "^1.0.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,svg,yml,yaml,toml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
